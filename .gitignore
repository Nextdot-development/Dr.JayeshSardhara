/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# migration working data — DELIBERATELY NOT COMMITTED
#
# _migration/ is the WordPress migration evidence and incident record. It stays on disk
# but is never pushed, because it contains:
#   - 01-xml/  the full WXR export, including the WordPress admin account recovery email
#             (an unresolved account-takeover vector — see _migration/SECURITY-CHECKLIST.md)
#   - 03-server-files/htaccess  the working Googlebot cloaking rule (a usable blueprint)
#   - 05-crawl/  203 page captures containing the injected spam markup and hosting identifiers
#
# None of it is needed to build or run the site.
/_migration/

# migrated WordPress media (583 MB, 2008 files) — see _migration/IMAGE-AUDIT.md
# ⚠️ Ignored means NOT deployed: Vercel builds from git, so these will 404 in
# production until they are served from object storage or restored at build time.
/public/wp-content/uploads/
